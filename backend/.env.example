# SafeRoute+ backend environment
# Rename this file to `.env` and place it in the backend root.
# NEVER commit `.env` to git (it must be listed in .gitignore).
# Blank Twilio / FCM values = the backend runs in MOCK mode (logs messages instead of sending).

# ---------------------------------------------------------------
# GENERATED BY THE AGENT (leave blank; the coding agent fills these)
# ---------------------------------------------------------------
# Random 64-char hex string, generated locally with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ---------------------------------------------------------------
# DEFAULTS (agent adjusts to match your local setup)
# ---------------------------------------------------------------
# Local Postgres for dev. Swap for the Supabase direct / session-pooler URI when deploying.
# (Do NOT use the transaction pooler on port 6543.)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saferoute

# Only used if you run a real OSRM server. Unused with the precomputed route_cache.
OSRM_BASE_URL=http://localhost:5000

# Escalation tuning (see backend-prompt.md section 5.5)
CHECKIN_WINDOW_SEC=45
ESCALATION_SUSTAINED_SEC=300
ALERT_COOLDOWN_SEC=300

# ---------------------------------------------------------------
# YOU PROVIDE (paste directly into this file yourself, not in chat)
# ---------------------------------------------------------------
# Twilio: twilio.com/console (free trial). Trial can only SMS VERIFIED numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Firebase: Console -> Project Settings -> Service accounts -> Generate new private key.
# Save the JSON somewhere outside git and put its path here.
FCM_SERVICE_ACCOUNT_JSON_PATH=

# Client URLs
EXPO_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------
# OPTIONAL (ignore unless you decide you want them)
# ---------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
PICOVOICE_ACCESS_KEY=
